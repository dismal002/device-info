<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Carried over from deviceprobe-java: all optional, so the app
         installs and runs even on a device with none of this hardware. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Normal (auto-granted) permissions used to read adapter state.
         BLUETOOTH_CONNECT is dangerous on API 31+ - without it,
         BluetoothAdapter.getName() just throws and the field is skipped
         (already wrapped in try/catch in DeviceProbe), rather than the
         app requesting it at runtime. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Required on Android 11+ for the Welcome Device Check's direct installed-package checks. -->
    <queries>
        <package android:name="com.example.artificialswitch" />
        <package android:name="com.kst.switchapp" />
        <package android:name="com.android.ext.instruction" />
        <package android:name="com.example.switchbootanim" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/MainAppTheme"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AboutDeviceActivity"
            android:exported="false"
            android:label="@string/about_settings"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
